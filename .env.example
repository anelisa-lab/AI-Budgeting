PORT=4000

# Postgres connection — fill in your dev DB details
DATABASE_URL=postgresql://username:password@localhost:5432/budget_app

# Secret used to sign JWTs — use any long random string for dev
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# Timezone used for "today" in the Daily Budget Split (both Python and Postgres)
APP_TIMEZONE=Africa/Johannesburg

# Websites allowed to call the API (comma-separated). Defaults to the Vite
# dev/preview servers on localhost; set it to the frontend's real address.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The ONE switch for which stores' live prices the app uses (comma-separated
# canonical store keys). Checkers and Shoprite are ready now (both run on the
# same underlying platform — see app/scrapers/sixty60_platform.py). Every
# other investigated store is catalogue-only, not live, and can't be added
# here:
#   - Pick n Pay's and Woolworths' robots.txt disallow their search path.
#   - Game's robots.txt disallows its search path too (Disallow: /search*).
#   - Boxer's site has no real online product catalogue to scrape at all.
#   - SPAR's SPAR2U prices depend on a chosen branch/delivery address, so
#     there is no single site-wide "SPAR" search to scrape.
#   - Food Lover's Market's site resets the connection on every automated
#     request (TLS-level bot protection) — not something to work around.
#   - GET /api/search (the Search page's "Live prices" cards): which stores are
#     searched, and only their rows are ever returned from the items table
#   - python -m app.price_feed refresh / probe: other stores are skipped and
#     keep the last price written to them
# To switch a ready store back on, add its key, e.g. LIVE_PRICE_STORES=checkers,shoprite
# The catalogue-only keys below (picknpay, spar, game, foodlovers, makro) add
# nothing to live search — none is in app/scrapers' SCRAPERS dict, so live
# search silently skips them — they are here only so PRICE_FEED_AUTO_REFRESH
# (below) is allowed to update their prices once the CSV has real ones.
LIVE_PRICE_STORES=checkers,shoprite,picknpay,spar,game,foodlovers,makro
# Maximum time allowed for one store's live request before it is marked unavailable.
LIVE_STORE_TIMEOUT_SECONDS=8
# How long a live search is answered from the database before the store is
# asked again (hours).
LIVE_SEARCH_TTL_HOURS=4

# Background refresh of the catalogue-only stores' prices (Pick n Pay, SPAR,
# Game, Food Lover's Market, Makro, ...) from docs/prices/verified_prices.csv,
# run on a timer inside the backend process — no OS cron needed. Turned on
# here so the catalogue refreshes itself continuously — BUT it only updates a
# store that is BOTH listed in LIVE_PRICE_STORES above AND has a non-blank
# price filled into that CSV. The CSV ships as a template with every price
# column blank (it needs a real person to check a real price and write it in
# — see the CSV's own header), so turning this on does not, by itself, change
# a single price: it is safe plumbing that starts working the moment real
# verified prices exist. Set to false to turn it off again.
PRICE_FEED_AUTO_REFRESH=true
# How often the background refresh runs (hours).
PRICE_FEED_REFRESH_HOURS=6
