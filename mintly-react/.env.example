# Copy to `.env.local` and adjust if your backend is not on the default port.
#
#   cp .env.example .env.local
#
# THERE IS NO MOCK MODE ANY MORE. Every screen talks to the real FastAPI
# backend in AI-Budgeting-main, so the backend must be running:
#
#   cd AI-Budgeting-main
#   source venv/bin/activate
#   uvicorn app.main:app --reload --port 4000
#
# The backend mounts its routers at the ROOT — /auth, /profile, /budgets,
# /search — so this value must NOT end in /api.
#
# Leave it unset and src/api/http.js falls back to http://localhost:4000,
# which is the port the backend's own README starts uvicorn on.

VITE_API_BASE_URL=http://localhost:4000
