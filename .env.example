PORT=4000

# Postgres connection — fill in your dev DB details
DATABASE_URL=postgresql://username:password@localhost:5432/budget_app

# Secret used to sign JWTs — use any long random string for dev
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# Timezone used for "today" in the Daily Budget Split (both Python and Postgres)
APP_TIMEZONE=Africa/Johannesburg

# Websites allowed to call the API (comma-separated). Defaults to the Vite
# dev/preview servers on localhost; set it to the frontend's real address.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stores the live price search calls (comma-separated keys from
# app/scrapers/__init__.py SCRAPERS). Only Checkers Sixty60 for now.
LIVE_PRICE_STORES=checkers
# How long a live search is answered from the database before the store is
# asked again (hours).
LIVE_SEARCH_TTL_HOURS=6
