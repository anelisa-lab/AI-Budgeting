PORT=4000

# Postgres connection — fill in your dev DB details
DATABASE_URL=postgresql://username:password@localhost:5432/budget_app

# Secret used to sign JWTs — use any long random string for dev
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# Timezone used for "today" in the Daily Budget Split (both Python and Postgres)
APP_TIMEZONE=Africa/Johannesburg

# Websites allowed to call the API (comma-separated). Defaults to the Vite
# dev/preview servers on localhost; set it to the frontend's real address.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The ONE switch for which stores' live prices the app uses (comma-separated
# store keys — see app/scrapers/__init__.py SCRAPERS for which keys have a
# live scraper). It controls:
#   - GET /api/search (the Search page's "Live prices" cards): which stores are
#     searched, in parallel, and only their rows are ever returned from the
#     items table
#   - python -m app.price_feed refresh / probe: other stores are skipped and
#     keep the last price written to them
# Only Checkers Sixty60 has a scraper today; add a key here (no code change)
# once shoprite.py / pnp.py exist, e.g.:
#   LIVE_PRICE_STORES=checkers,shoprite,picknpay
LIVE_PRICE_STORES=checkers
# How long a live search is answered from the database before the store is
# asked again (hours). The cache is per (store, query), so each store expires
# on its own schedule.
LIVE_SEARCH_TTL_HOURS=6
# How long GET /api/search waits on a single store's live fetch before
# treating it as unavailable for that request and returning the others
# anyway (seconds). That store's own request may still be running in the
# background; see app/scrapers/common.py.
LIVE_SEARCH_STORE_TIMEOUT_SECONDS=12
